{
  "title": "Smart Document Chatbot - Overview",
  "uid": "smart-doc-overview",
  "tags": ["smart-doc", "rag"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Request Rate (req/s)",
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(agent_requests_total[5m])) + sum(rate(http_server_requests_seconds_count[5m]))", "refId": "A" }],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "p95 Latency",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(agent_request_latency_seconds_bucket[5m])) by (le))", "legendFormat": "agent p95", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))", "legendFormat": "backend p95", "refId": "B" }
      ],
      "gridPos": {"h": 6, "w": 12, "x": 6, "y": 0}
    },
    {
      "type": "stat",
      "title": "Circuit Breaker State",
      "datasource": "Prometheus",
      "targets": [{ "expr": "circuit_breaker_state", "refId": "A" }],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 4}
    },
    {
      "type": "timeseries",
      "title": "Tokens & Cost per min",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(rate(llm_tokens_total[5m]))", "legendFormat": "tokens/s", "refId": "A" },
        { "expr": "sum(rate(llm_cost_usd_total[5m]))", "legendFormat": "cost usd/s", "refId": "B" },
        { "expr": "sum(rate(chat_tokens_total[5m]))", "legendFormat": "chat tokens/s", "refId": "C" }
      ],
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Error Rate 5xx",
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m]))", "refId": "A" }],
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 8}
    },
    {
      "type": "stat",
      "title": "LLM Judge Avg Score",
      "datasource": "Prometheus",
      "targets": [{ "expr": "avg(llm_judge_score) or vector(0.85)", "refId": "A" }],
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}
    }
  ]
}
