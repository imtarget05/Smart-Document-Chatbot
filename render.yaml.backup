# ============================================
# Render Blueprint — Smart Document Chatbot
# Deploy: push to main → Render auto-deploys
# Services:
#   1. smart-doc-llm-router (Python/FastAPI) → Cloudflare Workers AI
#   2. smart-doc-backend     (Spring Boot via Docker) → calls llm-router
# Frontend deploys separately to Cloudflare Pages (see README section).
# ============================================

services:
  # -----------------------------------------------------------
  # LLM Router — Ollama-compatible gateway, Cloudflare Workers AI primary
  # -----------------------------------------------------------
  - type: web
    name: smart-doc-llm-router
    runtime: python
    rootDir: llm-router
    plan: free
    buildCommand: pip install -r requirements.txt
    startCommand: uvicorn app.main:app --host 0.0.0.0 --port $PORT
    healthCheckPath: /health
    autoDeploy: true
    envVars:
      - key: CLOUDFLARE_ACCOUNT_ID
        sync: false
      - key: CLOUDFLARE_API_TOKEN
        sync: false
      - key: CLOUDFLARE_CHAT_MODEL
        value: "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
      - key: CLOUDFLARE_EMBED_MODEL
        value: "@cf/baai/bge-base-en-v1.5"
      - key: CLOUDFLARE_TIMEOUT_SECONDS
        value: "60"
      - key: ROUTER_CONFIDENCE_THRESHOLD
        value: "0.7"
      - key: ROUTER_INTERNAL_TOKEN
        sync: false

  # -----------------------------------------------------------
  # Backend — Spring Boot CRAG service (Docker build, Java 17)
  # -----------------------------------------------------------
  - type: web
    name: smart-doc-backend
    runtime: docker
    rootDir: .
    plan: free
    dockerfilePath: docker/Dockerfile.backend
    autoDeploy: true
    healthCheckPath: /api/actuator/health
    envVars:
      - key: SPRING_PROFILES_ACTIVE
        value: production
      # LLM routed through the router service above
      - key: LLM_BASE_URL
        fromService:
          name: smart-doc-llm-router
          type: web
          property: host
      - key: LLM_CHAT_MODEL
        value: "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
      - key: LLM_EMBEDDING_MODEL
        value: "@cf/baai/bge-base-en-v1.5"
      - key: LLM_TEMPERATURE
        value: "0.3"
      # Storage: Cloudflare R2
      - key: STORAGE_PROVIDER
        value: r2
      - key: R2_ACCOUNT_ID
        sync: false
      - key: R2_ACCESS_KEY_ID
        sync: false
      - key: R2_SECRET_ACCESS_KEY
        sync: false
      - key: R2_BUCKET_NAME
        value: smart-doc-documents
      # Database: Neon Serverless PostgreSQL
      - key: SPRING_DATASOURCE_URL
        sync: false
      - key: SPRING_JPA_HIBERNATE_DDL_AUTO
        value: update
      # Vector DB: Qdrant Cloud
      - key: QDRANT_HOST
        sync: false
      - key: QDRANT_PORT
        value: "6333"
      - key: QDRANT_USE_HTTPS
        value: "true"
      - key: QDRANT_API_KEY
        sync: false
      - key: QDRANT_COLLECTION
        value: documents
      # Security (generate with: openssl rand -base64 48)
      - key: JWT_SECRET
        sync: false
      - key: INTERNAL_SERVICE_TOKEN
        sync: false
      - key: CORS_ALLOWED_ORIGINS
        value: "*"
      - key: LOGGING_LEVEL_ROOT
        value: WARN
      - key: LOGGING_LEVEL_COM_SMARTDOCCHAT
        value: INFO