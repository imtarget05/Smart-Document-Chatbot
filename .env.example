# ============================================================================
# Smart Document Chatbot — Environment Configuration (TEMPLATE)
# ============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
# All secrets below are intentionally blank — you MUST provide strong values.
# Generate strong secrets with, e.g.:
#   openssl rand -base64 48        # for JWT_SECRET / INTERNAL_SERVICE_TOKEN
#   openssl rand -base64 24        # for service passwords
# ============================================================================

# --- Deployment Environment ---
# local | dev | staging | production
# In non-local envs, the agent service enforces strict secret validation.
APP_ENV=local

# --- LLM Configuration (Cloudflare Workers AI, no local Ollama) ---
# Get credentials at https://dash.cloudflare.com/profile/api-tokens (AI workers scope).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_EMBED_MODEL=@cf/baai/bge-base-en-v1.5
CLOUDFLARE_TIMEOUT_SECONDS=60

# Models used by the Agent service / Spring Boot backend (via the LLM router)
LLM_CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
LLM_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
LLM_TEMPERATURE=0.3

# --- Agent Configuration ---
# Comma-separated CORS origins. In production, set to explicit domains only
# (NO localhost / 127.0.0.1).
AGENT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
AGENT_MAX_REQUEST_BYTES=524288
AGENT_RATE_LIMIT_RPM=30
# MUST be >= 32 chars in non-local envs. Generate: openssl rand -base64 48
INTERNAL_SERVICE_TOKEN=

# --- n8n Workflow Automation (self-hosted via Docker Compose) ---
# UI: http://localhost:5678 — set strong credentials below (local self-host only).
# Never reuse these values in any shared environment.
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
# Dedicated Postgres for n8n execution history
N8N_POSTGRES_DB=n8n
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_PASSWORD=
# Deep integration with the Action Agent (n8n_config.py) is on the roadmap —
# N8N_BASE_URL/N8N_WEBHOOK_PATH/N8N_API_KEY will be consumed there.
#   Self-host:  N8N_BASE_URL=http://n8n:5678
#   Cloud:      N8N_BASE_URL=https://<your-instance>.app.n8n.cloud
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_PATH=/webhook
N8N_API_KEY=

# --- Corrective RAG (CRAG) — classic /chat/ask & /chat/ask-stream ---
# Top retrieval score below this triggers query reformulation / web / general fallback.
CRAG_CONFIDENCE_THRESHOLD=0.6
# Number of top chunks kept at each retrieval stage.
CRAG_TOP_K=3
# Number of alternative reformulations to try on low confidence.
CRAG_MAX_REFORMULATIONS=2
# Allow automatic web-search fallback on low confidence (independent of the
# per-request `webSearch` flag). Requires TAVILY_API_KEY.
CRAG_WEB_SEARCH_ENABLED=false

# --- Tavily Web Search (optional) ---
# Used by the CRAG web-search fallback. Leave empty to disable web search
# and fall back to general-knowledge answers.
TAVILY_API_KEY=

# --- Database ---
# Spring Boot (dev): local PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/smart_doc_chatbot
POSTGRES_USER=postgres
# MUST be >= 12 chars in non-local envs. Generate: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=smart_doc_chatbot

# Production backend datasource — Neon Serverless PostgreSQL
# (set NEON_DATABASE_URL and unset/comment DATABASE_URL in production)
NEON_DATABASE_URL=
# Agent service connects to the same Postgres for long-term memory
NEON_POSTGRES_HOST=localhost

# --- File Storage (Cloudflare R2 default; local disk for dev) ---
# R2: free 10 GB, no egress fees, no 7-day activity requirement.
# Create R2 API token at https://dash.cloudflare.com -> R2 -> Manage R2 API Tokens
# (Permissions: Object Read & Write on the bucket below.)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=smart-doc-documents
# Optional explicit endpoint (defaults to https://<account_id>.r2.cloudflarestorage.com)
R2_ENDPOINT=
# Legacy Supabase (kept for backward compatibility)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documents

# --- Vector Store ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_USE_HTTPS=false
# Leave empty for local unauthenticated Qdrant; set real key for Qdrant Cloud.
QDRANT_API_KEY=

# --- Redis (opt-in rate limiting + short-term memory) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Leave empty to fall back to in-memory. Example: redis://redis:6379/0
REDIS_URL=

# --- Monitoring ---
MLFLOW_TRACKING_URI=http://localhost:5000
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# --- Server ---
SERVER_PORT=8080
# Agent (Python FastAPI) service on the Docker network (container port 9000)
AGENT_SERVICE_URL=http://agent:9000
LOG_LEVEL=INFO

# --- Security ---
# MUST be a cryptographically random base64 string >= 32 bytes.
# Generate: openssl rand -base64 48
JWT_SECRET=
UPLOAD_MAX_FILE_SIZE=10485760
