# ============================================================================
# Smart Document Chatbot — Environment Template
# Copy to `.env` and fill real values. NEVER commit `.env` (secret).
# Used by docker/docker-compose.yml (backend / llm-router / agent / airflow).
# CI fullstack/airflow jobs read these from GitHub repo Secrets.
# ============================================================================

# ---- Database (Neon serverless Postgres) ----
# Format: postgresql://<user>:<password>@<host>/<db>?sslmode=require
NEON_DATABASE_URL=
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
POSTGRES_DB=neondb
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=
NEON_POSTGRES_HOST=
POSTGRES_PORT=5432

# ---- Vector DB (Qdrant Cloud) ----
QDRANT_HOST=
QDRANT_PORT=6333
QDRANT_USE_HTTPS=false
QDRANT_API_KEY=

# ---- File storage (Cloudflare R2) ----
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=smart-doc-documents
R2_ENDPOINT=

# ---- LLM (Cloudflare Workers AI via llm-router) ----
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_EMBED_MODEL=@cf/baai/bge-base-en-v1.5
CLOUDFLARE_TIMEOUT_SECONDS=60
LLM_ROUTER_PORT=8001
LLM_TOP_P=0.95  # top-p (nucleus) sampling used by the backend-and-router LLM calls

# ---- Secrets (fail-fast if empty in staging/prod) ----
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=

# ---- Web search (optional, Tavily) ----
TAVILY_API_KEY=

# ---- Agent service ----
AGENT_BASE_URL=http://agent:9000
AGENT_PORT=9000

# ---- Airflow (batch ingestion DAG) ----
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_DB=airflow
AIRFLOW_PORT=8081
# Credentials the ingestion DAG uses to log into the backend:
AIRFLOW_INGEST_OWNER=airflow-bot
AIRFLOW_INGEST_USERNAME=airflow-bot
AIRFLOW_INGEST_PASSWORD=

# ---- Frontend ----
VITE_API_URL=/api
FRONTEND_PORT=80

# ---- Backend ----
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=default
LOGGING_LEVEL_ROOT=INFO

# ---- n8n (optional automation) ----
N8N_PORT=5678
N8N_POSTGRES_DB=n8n
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_PASSWORD=n8n
